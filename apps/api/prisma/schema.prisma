// Phase 1: school core (teachers, students, classes, timetable) and gate attendance.
// Phase 2: finance (tuition, QR payments, MISA sync), store, canteen, library, health.
// Phase 3: notifications, parent accounts, homeroom attendance and logbook, school bus,
// admissions, HR and assets.
// Every tenant-owned row carries schoolId. Money is stored as whole VND in Int columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ADMIN / STAFF / TEACHER use the school portal. PARENT and DRIVER only reach
// routes that name their role explicitly (see AuthGuard).
enum Role {
  ADMIN
  STAFF
  TEACHER
  PARENT
  DRIVER
  STUDENT
  // Phòng / Sở GD&ĐT officer: reads aggregated data of the schools of their district, no school of their own.
  DISTRICT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

enum StudentStatus {
  STUDYING
  TRANSFERRED
  DROPPED
  GRADUATED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum Session {
  MORNING
  AFTERNOON
}

enum DeviceType {
  FACE
  FINGERPRINT
  CARD
  QR
  MULTI
}

// BIOMETRIC: face and/or fingerprint enrolled on terminals, keyed by the
// terminal's person ID. CARD / QR: keyed by card number or QR payload.
enum IdentityMethod {
  BIOMETRIC
  CARD
  QR
}

enum EventMethod {
  FACE
  FINGERPRINT
  CARD
  QR
  MANUAL
  UNKNOWN
}

enum Direction {
  IN
  OUT
  UNKNOWN
}

enum EventSource {
  DEVICE
  MANUAL
}

model School {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  address       String?
  // IANA timezone used for "school day" boundaries and device local times.
  timezone      String   @default("Asia/Ho_Chi_Minh")
  // Students whose first check-in is after this local time (HH:mm) are late.
  lateAfter     String   @default("07:15")
  // Phase 5: the Phòng / Sở GD&ĐT the school reports to, and its code in the MOET education database (CSDL ngành).
  districtId    String?
  moetCode      String?
  province      String?
  // Phase 6: letterhead and signer of official reports ("UBND phường Bình Phước", the principal, the place on the date line).
  governingBody String?
  principalName String?
  locality      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  district    District?    @relation(fields: [districtId], references: [id])
  dailyStats  DailyStat[]
  alertRules  AlertRule[]
  alertEvents AlertEvent[]
  moetExports MoetExport[]

  gradeColumnLocks  GradeColumnLock[]
  gradeEntryWindows GradeEntryWindow[]
  scoreEdits        ScoreEdit[]
  subjectExemptions SubjectExemption[]
  gradeVisibility   GradeVisibility?

  subjectRetakes    SubjectRetake[]
  summerTrainings   SummerTraining[]
  completionRounds  CompletionRound[]
  completionRecords CompletionRecord[]

  smsSetting   SmsSetting?
  smsTemplates SmsTemplate[]
  smsCampaigns SmsCampaign[]
  moetSyncs    MoetSync[]
  eRecords     ERecord[]

  studentMovements   StudentMovement[]
  studentAwards      StudentAward[]
  studentDisciplines StudentDiscipline[]
  absenceRequests    AbsenceRequest[]

  dutyTypes           DutyType[]
  teacherDuties       TeacherDuty[]
  teachingAssignments TeachingAssignment[]
  workloadSetting     WorkloadSetting?
  lessonPlans         LessonPlan[]
  homeroomBooks       HomeroomBook[]
  homeroomMonthPlans  HomeroomMonthPlan[]
  parentMeetings      ParentMeeting[]
  studentNotes        StudentNote[]
  homeroomBookReviews HomeroomBookReview[]

  users         User[]
  teachers      Teacher[]
  students      Student[]
  subjects      Subject[]
  academicYears AcademicYear[]
  classes       Class[]
  periods       Period[]
  timetable     TimetableEntry[]
  devices       AttendanceDevice[]
  identities    AttendanceIdentity[]
  gateEvents    GateEvent[]

  financeSettings       FinanceSettings?
  feeItems              FeeItem[]
  discounts             StudentDiscount[]
  campaigns             BillingCampaign[]
  invoices              Invoice[]
  payments              Payment[]
  bankTransactions      BankTransaction[]
  accountingJobs        AccountingSyncJob[]
  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  storeOrders           StoreOrder[]
  mealMenus             MealMenu[]
  mealRegistrations     MealRegistration[]
  books                 Book[]
  bookCopies            BookCopy[]
  loans                 Loan[]
  reservations          BookReservation[]
  healthProfiles        HealthProfile[]
  healthChecks          HealthCheck[]
  vaccinations          Vaccination[]
  healthIncidents       HealthIncident[]
  notificationSettings  NotificationSettings?
  notifications         Notification[]
  announcements         Announcement[]
  homeroomAttendances   HomeroomAttendance[]
  lessonLogs            LessonLog[]
  vehicles              Vehicle[]
  busStaffs             BusStaff[]
  busRoutes             BusRoute[]
  busAssignments        BusAssignment[]
  busTrips              BusTrip[]
  boardingEvents        BoardingEvent[]
  admissionRounds       AdmissionRound[]
  admissionApplications AdmissionApplication[]
  serviceRegistrations  ServiceRegistration[]
  employees             Employee[]
  leaveRequests         LeaveRequest[]
  assetCategories       AssetCategory[]
  suppliers             Supplier[]
  assets                Asset[]
  assetLoans            AssetLoan[]
  assetAudits           AssetAudit[]

  subjectSettings    SubjectSetting[]
  scores             Score[]
  subjectResults     SubjectResult[]
  termResults        TermResult[]
  gradeLocks         GradeLock[]
  conductCriteria    ConductCriterion[]
  conductAssessments ConductAssessment[]
  storedFiles        StoredFile[]
  courses            Course[]
  lessons            Lesson[]
  discussionThreads  DiscussionThread[]
  liveSessions       LiveSession[]
  questions          Question[]
  tests              Test[]
}

model User {
  id                 String   @id @default(cuid())
  // Null only for district officers (role DISTRICT), who belong to a District instead.
  schoolId           String?
  districtId         String?
  // Staff log in with email; parents and drivers with their phone number (digits only).
  email              String?  @unique
  phone              String?  @unique
  // Students log in with their student code (lower-case; a school code suffix is added on collision).
  username           String?  @unique
  passwordHash       String
  fullName           String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school        School?                @relation(fields: [schoolId], references: [id])
  district      District?              @relation(fields: [districtId], references: [id])
  teacher       Teacher?
  guardians     Guardian[]
  notifications Notification[]
  pushTokens    PushToken[]
  rsvps         AnnouncementResponse[]
  busStaff      BusStaff?
  employee      Employee?
  student       Student?
  storedFiles   StoredFile[]
  threads       DiscussionThread[]
  posts         DiscussionPost[]

  signatureProfile SignatureProfile?

  @@index([schoolId])
  @@index([districtId])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  code     String
  name     String

  school     School           @relation(fields: [schoolId], references: [id])
  teachers   TeacherSubject[]
  timetable  TimetableEntry[]
  lessonLogs LessonLog[]

  settings       SubjectSetting[]
  scores         Score[]
  subjectResults SubjectResult[]
  courses        Course[]
  questions      Question[]
  tests          Test[]
  columnLocks    GradeColumnLock[]
  exemptions     SubjectExemption[]
  retakes        SubjectRetake[]

  assignments TeachingAssignment[]
  lessonPlans LessonPlan[]

  @@unique([schoolId, code])
}

model Teacher {
  id          String        @id @default(cuid())
  schoolId    String
  code        String
  fullName    String
  gender      Gender?
  dateOfBirth DateTime?     @db.Date
  phone       String?
  email       String?
  status      TeacherStatus @default(ACTIVE)
  userId      String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// Tổ chuyên môn: "Tổ Toán - Khoa học tự nhiên".
  subjectGroup String?

  school          School               @relation(fields: [schoolId], references: [id])
  user            User?                @relation(fields: [userId], references: [id])
  subjects        TeacherSubject[]
  homeroomClasses Class[]
  timetable       TimetableEntry[]
  identities      AttendanceIdentity[]
  gateEvents      GateEvent[]
  loans           Loan[]
  lessonLogs      LessonLog[]
  employee        Employee?
  scores          Score[]
  courses         Course[]

  duties      TeacherDuty[]
  assignments TeachingAssignment[]
  lessonPlans LessonPlan[]

  @@unique([schoolId, code])
  @@index([schoolId, fullName])
}

model TeacherSubject {
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

model Student {
  id          String        @id @default(cuid())
  schoolId    String
  code        String
  fullName    String
  gender      Gender?
  dateOfBirth DateTime?     @db.Date
  address     String?
  status      StudentStatus @default(STUDYING)
  // Student login account (phase 4).
  userId      String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Phase 9: the rest of the student record, as the sổ đăng bộ and CSDL ngành ask for it.
  /// Mã định danh cá nhân: the 12-digit number of the citizen ID (CCCD, VNeID).
  idNumber          String?
  /// The student's code in CSDL ngành.
  moetCode          String?
  birthPlace        String?
  hometown          String?
  ethnicity         String?
  religion          String?
  nationality       String?       @default("Việt Nam")
  /// Chỗ ở hiện nay: `address` keeps the house number and street, these the ward and province.
  currentWard       String?
  currentProvince   String?
  /// Nơi thường trú.
  permanentAddress  String?
  permanentWard     String?
  permanentProvince String?
  policyGroups      PolicyGroup[] @default([])
  /// Đội viên of the Đội TNTP Hồ Chí Minh, đoàn viên of the Đoàn TNCS Hồ Chí Minh.
  youngPioneer      Boolean       @default(false)
  youthUnion        Boolean       @default(false)

  school      School               @relation(fields: [schoolId], references: [id])
  user        User?                @relation(fields: [userId], references: [id])
  guardians   Guardian[]
  enrollments Enrollment[]
  identities  AttendanceIdentity[]
  gateEvents  GateEvent[]

  discounts         StudentDiscount[]
  invoices          Invoice[]
  payments          Payment[]
  storeOrders       StoreOrder[]
  mealRegistrations MealRegistration[]
  loans             Loan[]
  reservations      BookReservation[]
  healthProfile     HealthProfile?
  healthChecks      HealthCheck[]
  vaccinations      Vaccination[]
  healthIncidents   HealthIncident[]

  notifications        Notification[]
  homeroomAttendance   HomeroomAttendance[]
  busAssignments       BusAssignment[]
  boardingEvents       BoardingEvent[]
  application          AdmissionApplication?
  serviceRegistrations ServiceRegistration[]

  scores             Score[]
  subjectResults     SubjectResult[]
  termResults        TermResult[]
  conductAssessments ConductAssessment[]
  courseEnrollments  CourseEnrollment[]
  lessonProgress     LessonProgress[]
  testAttempts       TestAttempt[]
  liveAttendances    LiveAttendance[]
  subjectExemptions  SubjectExemption[]
  subjectRetakes     SubjectRetake[]
  summerTraining     SummerTraining[]
  completionRecords  CompletionRecord[]
  eRecords           ERecord[]

  movements       StudentMovement[]
  awards          StudentAward[]
  disciplines     StudentDiscipline[]
  absenceRequests AbsenceRequest[]

  notes StudentNote[]

  @@unique([schoolId, code])
  @@index([schoolId, fullName])
}

model Guardian {
  id           String               @id @default(cuid())
  studentId    String
  fullName     String
  relationship GuardianRelationship
  phone        String
  email        String?
  isPrimary    Boolean              @default(false)
  // Parent login account; one account covers every child with the same phone.
  userId       String?
  // Phase 9: what the sổ đăng bộ and CSDL ngành record of the parents.
  birthYear    Int?
  occupation   String?
  /// Số CCCD.
  idNumber     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([studentId])
  @@index([userId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)

  school      School            @relation(fields: [schoolId], references: [id])
  classes     Class[]
  enrollments Enrollment[]
  timetable   TimetableEntry[]
  campaigns   BillingCampaign[]

  admissionRounds      AdmissionRound[]
  serviceRegistrations ServiceRegistration[]
  busAssignments       BusAssignment[]

  scores             Score[]
  subjectResults     SubjectResult[]
  termResults        TermResult[]
  gradeLocks         GradeLock[]
  conductAssessments ConductAssessment[]
  courses            Course[]

  teacherDuties       TeacherDuty[]
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, name])
}

model Class {
  id                String  @id @default(cuid())
  schoolId          String
  academicYearId    String
  name              String
  gradeLevel        Int
  homeroomTeacherId String?
  room              String?

  school          School           @relation(fields: [schoolId], references: [id])
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  homeroomTeacher Teacher?         @relation(fields: [homeroomTeacherId], references: [id])
  enrollments     Enrollment[]
  timetable       TimetableEntry[]

  homeroomAttendance HomeroomAttendance[]
  lessonLogs         LessonLog[]
  applications       AdmissionApplication[]

  scores             Score[]
  subjectResults     SubjectResult[]
  termResults        TermResult[]
  gradeLocks         GradeLock[]
  conductAssessments ConductAssessment[]
  subjectRetakes     SubjectRetake[]
  summerTrainings    SummerTraining[]
  completionRecords  CompletionRecord[]
  smsQuota           SmsClassQuota?

  movementsFrom   StudentMovement[]   @relation("MovementFrom")
  movementsTo     StudentMovement[]   @relation("MovementTo")
  awards          StudentAward[]
  disciplines     StudentDiscipline[]
  absenceRequests AbsenceRequest[]

  assignments    TeachingAssignment[]
  lessonPlans    LessonPlan[]
  homeroomBook   HomeroomBook?
  monthPlans     HomeroomMonthPlan[]
  parentMeetings ParentMeeting[]
  studentNotes   StudentNote[]
  bookReviews    HomeroomBookReview[]

  @@unique([academicYearId, name])
  @@index([schoolId])
}

// A student belongs to at most one class per academic year.
model Enrollment {
  id             String   @id @default(cuid())
  classId        String
  studentId      String
  academicYearId String
  enrolledAt     DateTime @default(now())

  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([classId])
}

// Bell schedule: "Tiết 1" 07:00-07:45 etc.
model Period {
  id        String  @id @default(cuid())
  schoolId  String
  number    Int
  session   Session
  startTime String
  endTime   String

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, number])
}

// One cell of the timetable. Uniques stop a class or a teacher being double-booked;
// room clashes are checked in the service because room is optional.
model TimetableEntry {
  id             String  @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  classId        String
  subjectId      String
  teacherId      String
  dayOfWeek      Int // 1 = Monday ... 7 = Sunday
  periodNumber   Int
  room           String?

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])

  @@unique([classId, semester, dayOfWeek, periodNumber])
  @@unique([teacherId, academicYearId, semester, dayOfWeek, periodNumber])
  @@index([schoolId, academicYearId, semester])
}

// A gate terminal (face, fingerprint, card reader...). Devices authenticate
// either with an API key (generic JSON API) or by serial number (ZKTeco ADMS push).
model AttendanceDevice {
  id               String     @id @default(cuid())
  schoolId         String
  name             String
  type             DeviceType
  vendor           String?
  serialNumber     String?    @unique
  location         String?
  defaultDirection Direction  @default(UNKNOWN)
  apiKeyPrefix     String     @unique
  apiKeyHash       String
  isActive         Boolean    @default(true)
  lastSeenAt       DateTime?
  createdAt        DateTime   @default(now())

  school School      @relation(fields: [schoolId], references: [id])
  events GateEvent[]

  @@index([schoolId])
}

// Maps the person ID stored on a terminal (or a card number) to a student or
// teacher. BIOMETRIC identities require recorded consent (Decree 13/2023/ND-CP:
// a parent or guardian for students); revoking consent deactivates them.
model AttendanceIdentity {
  id                  String         @id @default(cuid())
  schoolId            String
  method              IdentityMethod
  externalId          String
  studentId           String?
  teacherId           String?
  consentGivenBy      String?
  consentRelationship String?
  consentAt           DateTime?
  consentReference    String?
  revokedAt           DateTime?
  createdAt           DateTime       @default(now())

  school  School   @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([schoolId, method, externalId])
  @@index([studentId])
  @@index([teacherId])
}

model GateEvent {
  id               String      @id @default(cuid())
  schoolId         String
  deviceId         String?
  externalEventId  String?
  externalPersonId String?
  studentId        String?
  teacherId        String?
  method           EventMethod
  direction        Direction
  occurredAt       DateTime
  source           EventSource
  recordedById     String?
  note             String?
  rawPayload       Json?
  createdAt        DateTime    @default(now())

  school  School            @relation(fields: [schoolId], references: [id])
  device  AttendanceDevice? @relation(fields: [deviceId], references: [id])
  student Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher?          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalEventId])
  @@index([schoolId, occurredAt])
  @@index([studentId, occurredAt])
  @@index([teacherId, occurredAt])
}

// ============================================================================
// Phase 2: finance
// ============================================================================

enum FeeUnit {
  MONTH
  TERM
  YEAR
  ONCE
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  // Remaining balance was moved onto a newer invoice as "nợ kỳ trước".
  CARRIED_OVER
  CANCELLED
}

enum InvoiceSource {
  CAMPAIGN
  STORE
  MANUAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QR
}

enum PaymentStatus {
  CONFIRMED
  VOIDED
}

enum BankTxnStatus {
  MATCHED
  UNMATCHED
  IGNORED
}

enum SyncKind {
  RECEIPT
  RECEIPT_VOID
  STOCK_IN
  STOCK_OUT
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

// Bank account that receives transfers (shown in VietQR codes). These are the
// account details printed on a QR, not credentials; provider secrets live in env.
model FinanceSettings {
  id              String  @id @default(cuid())
  schoolId        String  @unique
  bankBin         String? // NAPAS bank BIN, e.g. 970436 (Vietcombank)
  bankName        String?
  bankAccountNo   String? @unique
  bankAccountName String?
  receiptPrefix   String  @default("PT")
  nextReceiptNo   Int     @default(1)

  school School @relation(fields: [schoolId], references: [id])
}

// Khoản thu: tuition, meals, transport, insurance...
model FeeItem {
  id             String   @id @default(cuid())
  schoolId       String
  code           String
  name           String
  unit           FeeUnit  @default(MONTH)
  defaultAmount  Int
  // Revenue account / item code used when the receipt is pushed to accounting.
  accountingCode String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  school        School            @relation(fields: [schoolId], references: [id])
  campaignItems CampaignItem[]
  invoiceLines  InvoiceLine[]
  discounts     StudentDiscount[]

  @@unique([schoolId, code])
}

// Per-student reduction (siblings, staff children, policy beneficiaries...).
// Applies to one fee item, or to every item when feeItemId is null.
model StudentDiscount {
  id        String       @id @default(cuid())
  schoolId  String
  studentId String
  feeItemId String?
  kind      DiscountKind
  value     Int // percent (0-100) or VND
  reason    String
  validFrom DateTime?    @db.Date
  validTo   DateTime?    @db.Date
  createdAt DateTime     @default(now())

  school  School   @relation(fields: [schoolId], references: [id])
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeItem FeeItem? @relation(fields: [feeItemId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// Đợt thu: a billing run (e.g. "Học phí tháng 10/2026") that issues one invoice per student.
model BillingCampaign {
  id             String         @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  dueDate        DateTime       @db.Date
  // Empty = every grade / every class.
  gradeLevels    Int[]
  classIds       String[]
  carryOverDebt  Boolean        @default(true)
  status         CampaignStatus @default(DRAFT)
  createdAt      DateTime       @default(now())

  school       School         @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  items        CampaignItem[]
  invoices     Invoice[]

  @@index([schoolId])
}

model CampaignItem {
  id         String @id @default(cuid())
  campaignId String
  feeItemId  String
  amount     Int
  quantity   Int    @default(1)

  campaign BillingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  feeItem  FeeItem         @relation(fields: [feeItemId], references: [id])

  @@unique([campaignId, feeItemId])
}

model Invoice {
  id                 String        @id @default(cuid())
  schoolId           String
  studentId          String
  campaignId         String?
  source             InvoiceSource
  title              String
  // Transfer reference printed in the QR and matched in bank webhooks (globally unique).
  paymentRef         String        @unique
  status             InvoiceStatus @default(UNPAID)
  subtotal           Int
  discountTotal      Int           @default(0)
  total              Int
  paidAmount         Int           @default(0)
  dueDate            DateTime?     @db.Date
  carriedToInvoiceId String?
  issuedAt           DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  school      School           @relation(fields: [schoolId], references: [id])
  student     Student          @relation(fields: [studentId], references: [id])
  campaign    BillingCampaign? @relation(fields: [campaignId], references: [id])
  carriedTo   Invoice?         @relation("CarryOver", fields: [carriedToInvoiceId], references: [id])
  carriedFrom Invoice[]        @relation("CarryOver")
  lines       InvoiceLine[]
  payments    Payment[]
  storeOrder  StoreOrder?

  @@unique([campaignId, studentId])
  @@index([schoolId, status])
  @@index([studentId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  feeItemId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  discount    Int     @default(0)
  amount      Int

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem FeeItem? @relation(fields: [feeItemId], references: [id])

  @@index([invoiceId])
}

// Phiếu thu. One payment settles (part of) one invoice.
model Payment {
  id            String        @id @default(cuid())
  schoolId      String
  invoiceId     String
  studentId     String
  receiptNo     String
  method        PaymentMethod
  amount        Int
  paidAt        DateTime      @default(now())
  status        PaymentStatus @default(CONFIRMED)
  collectedById String?
  note          String?
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime      @default(now())

  school          School           @relation(fields: [schoolId], references: [id])
  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id])
  bankTransaction BankTransaction?

  @@unique([schoolId, receiptNo])
  @@index([schoolId, paidAt])
  @@index([invoiceId])
}

// Incoming transfer reported by the payment provider's webhook. Kept even when it
// cannot be matched to an invoice so the accountant can reconcile it by hand.
model BankTransaction {
  id          String        @id @default(cuid())
  schoolId    String
  provider    String
  externalId  String
  amount      Int
  description String
  occurredAt  DateTime
  status      BankTxnStatus
  paymentId   String?       @unique
  note        String?
  rawPayload  Json?
  createdAt   DateTime      @default(now())

  school  School   @relation(fields: [schoolId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, externalId])
  @@index([schoolId, status])
}

// Outbox for the accounting system (MISA AMIS). One job per business document,
// so retries never create duplicate vouchers.
model AccountingSyncJob {
  id            String     @id @default(cuid())
  schoolId      String
  kind          SyncKind
  entityId      String
  payload       Json
  status        SyncStatus @default(PENDING)
  attempts      Int        @default(0)
  lastError     String?
  externalRef   String?
  nextAttemptAt DateTime   @default(now())
  syncedAt      DateTime?
  createdAt     DateTime   @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@unique([kind, entityId])
  @@index([status, nextAttemptAt])
  @@index([schoolId, createdAt])
}

// ============================================================================
// Phase 2: issuance / store (cấp phát)
// ============================================================================

enum ItemCategory {
  UNIFORM
  BOOK
  EQUIPMENT
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum StoreOrderStatus {
  PENDING
  ISSUED
  CANCELLED
}

model InventoryItem {
  id             String       @id @default(cuid())
  schoolId       String
  sku            String
  name           String
  category       ItemCategory
  unit           String       @default("cái")
  price          Int
  stockQty       Int          @default(0)
  accountingCode String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  school     School           @relation(fields: [schoolId], references: [id])
  movements  StockMovement[]
  orderLines StoreOrderLine[]

  @@unique([schoolId, sku])
}

model StockMovement {
  id          String            @id @default(cuid())
  schoolId    String
  itemId      String
  type        StockMovementType
  // Signed change in stock: positive for IN, negative for OUT, either for ADJUST.
  quantity    Int
  unitCost    Int?
  reason      String?
  orderId     String?
  createdById String?
  createdAt   DateTime          @default(now())

  school School        @relation(fields: [schoolId], references: [id])
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order  StoreOrder?   @relation(fields: [orderId], references: [id])

  @@index([itemId, createdAt])
}

model StoreOrder {
  id        String           @id @default(cuid())
  schoolId  String
  code      String
  studentId String
  status    StoreOrderStatus @default(PENDING)
  total     Int
  invoiceId String?          @unique
  note      String?
  issuedAt  DateTime?
  createdAt DateTime         @default(now())

  school    School           @relation(fields: [schoolId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])
  invoice   Invoice?         @relation(fields: [invoiceId], references: [id])
  lines     StoreOrderLine[]
  movements StockMovement[]

  @@unique([schoolId, code])
}

model StoreOrderLine {
  id        String @id @default(cuid())
  orderId   String
  itemId    String
  quantity  Int
  unitPrice Int
  amount    Int

  order StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  InventoryItem @relation(fields: [itemId], references: [id])
}

// ============================================================================
// Phase 2: canteen (bán trú)
// ============================================================================

enum MealType {
  BREAKFAST
  LUNCH
  SNACK
}

model MealMenu {
  id       String   @id @default(cuid())
  schoolId String
  date     DateTime @db.Date
  mealType MealType
  dishes   String[]
  price    Int
  // Registrations can be changed until this local time (HH:mm) on the day.
  cutoff   String   @default("08:30")

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, date, mealType])
}

model MealRegistration {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  date        DateTime  @db.Date
  mealType    MealType
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, mealType])
  @@index([schoolId, date])
}

// ============================================================================
// Phase 2: library
// ============================================================================

enum CopyStatus {
  AVAILABLE
  BORROWED
  LOST
  RETIRED
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

model Book {
  id        String   @id @default(cuid())
  schoolId  String
  isbn      String?
  title     String
  author    String?
  publisher String?
  year      Int?
  category  String?
  createdAt DateTime @default(now())

  school       School            @relation(fields: [schoolId], references: [id])
  copies       BookCopy[]
  reservations BookReservation[]

  @@index([schoolId, title])
  @@index([schoolId, isbn])
}

model BookCopy {
  id       String     @id @default(cuid())
  schoolId String
  bookId   String
  barcode  String
  status   CopyStatus @default(AVAILABLE)
  shelf    String?

  school School @relation(fields: [schoolId], references: [id])
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans  Loan[]

  @@unique([schoolId, barcode])
  @@index([bookId])
}

model Loan {
  id         String    @id @default(cuid())
  schoolId   String
  copyId     String
  studentId  String?
  teacherId  String?
  borrowedAt DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  renewCount Int       @default(0)

  school  School   @relation(fields: [schoolId], references: [id])
  copy    BookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, returnedAt, dueAt])
  @@index([copyId])
  @@index([studentId])
}

model BookReservation {
  id          String            @id @default(cuid())
  schoolId    String
  bookId      String
  studentId   String
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  fulfilledAt DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([bookId, status, createdAt])
}

// ============================================================================
// Phase 2: health (y tế học đường)
// ============================================================================

enum IncidentSeverity {
  MINOR
  MODERATE
  SERIOUS
}

model HealthProfile {
  id                String    @id @default(cuid())
  schoolId          String
  studentId         String    @unique
  bloodType         String?
  allergies         String?
  chronicConditions String?
  // Mã thẻ bảo hiểm y tế (BHYT)
  insuranceNumber   String?
  insuranceExpiry   DateTime? @db.Date
  notes             String?
  updatedAt         DateTime  @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model HealthCheck {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  checkedAt   DateTime @db.Date
  heightCm    Float?
  weightKg    Float?
  bmi         Float?
  visionLeft  String?
  visionRight String?
  dental      String?
  conclusion  String?
  createdAt   DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, checkedAt])
}

model Vaccination {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  vaccine   String
  dose      Int      @default(1)
  givenAt   DateTime @db.Date
  notes     String?

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model HealthIncident {
  id               String           @id @default(cuid())
  schoolId         String
  studentId        String
  occurredAt       DateTime
  severity         IncidentSeverity
  description      String
  treatment        String?
  guardianNotified Boolean          @default(false)
  recordedById     String?
  createdAt        DateTime         @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, occurredAt])
  @@index([studentId])
}

// ============================================================================
// Phase 3: notifications and announcements
// ============================================================================

enum NotificationChannel {
  IN_APP
  PUSH
  ZALO
  SMS
  EMAIL
}

enum NotificationKind {
  GATE_IN
  GATE_OUT
  HOMEROOM_ABSENT
  HOMEROOM_LATE
  BUS_BOARD
  BUS_ALIGHT
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  HEALTH_INCIDENT
  LEAVE_DECIDED
  ANNOUNCEMENT
  EVENT
  SYSTEM
  GRADE_UPDATED
  CONDUCT_APPROVED
  COURSE_PUBLISHED
  TEST_ASSIGNED
  LIVE_CLASS
  ALERT
  // Phase 9
  ABSENCE_REQUEST
  ABSENCE_DECIDED
  STUDENT_AWARD
  STUDENT_DISCIPLINE
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum RsvpResponse {
  GOING
  NOT_GOING
  MAYBE
}

// Which channels a school pays for. IN_APP is always on.
model NotificationSettings {
  id       String                @id @default(cuid())
  schoolId String                @unique
  channels NotificationChannel[] @default([IN_APP])

  school School @relation(fields: [schoolId], references: [id])
}

// One message to one user. Deliveries fan it out to the enabled channels.
model Notification {
  id             String           @id @default(cuid())
  schoolId       String
  userId         String
  kind           NotificationKind
  title          String
  body           String
  data           Json?
  studentId      String?
  announcementId String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  school       School                 @relation(fields: [schoolId], references: [id])
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  student      Student?               @relation(fields: [studentId], references: [id], onDelete: SetNull)
  announcement Announcement?          @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([schoolId, createdAt])
  @@index([announcementId])
}

// Outbox for push / Zalo / SMS / email, pushed by the dispatcher with retries.
model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         SyncStatus          @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  externalRef    String?
  nextAttemptAt  DateTime            @default(now())
  sentAt         DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

// Device tokens for the future mobile apps (FCM / APNs).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Sự kiện / thông báo: a campaign sent to an audience (roles, classes, grades).
model Announcement {
  id          String                @id @default(cuid())
  schoolId    String
  kind        NotificationKind      @default(ANNOUNCEMENT)
  title       String
  body        String
  eventAt     DateTime?
  location    String?
  rsvp        Boolean               @default(false)
  // { roles: Role[], classIds: string[], gradeLevels: number[] }; empty lists mean everyone in that dimension.
  audience    Json
  channels    NotificationChannel[] @default([IN_APP])
  scheduledAt DateTime?
  sentAt      DateTime?
  status      AnnouncementStatus    @default(DRAFT)
  recipients  Int                   @default(0)
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  school        School                 @relation(fields: [schoolId], references: [id])
  notifications Notification[]
  responses     AnnouncementResponse[]

  @@index([schoolId, status, scheduledAt])
}

model AnnouncementResponse {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  response       RsvpResponse
  respondedAt    DateTime     @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

// ============================================================================
// Phase 3: homeroom attendance (điểm danh đầu giờ) and lesson logbook (sổ đầu bài)
// ============================================================================

enum HomeroomStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum LessonLogStatus {
  DONE
  CANCELLED
}

model HomeroomAttendance {
  id           String         @id @default(cuid())
  schoolId     String
  classId      String
  studentId    String
  date         DateTime       @db.Date
  status       HomeroomStatus
  note         String?
  recordedById String?
  updatedAt    DateTime       @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, date, studentId])
  @@index([schoolId, date])
  @@index([studentId, date])
}

// One period taught: what was covered, who was absent, the teacher's remark and a rating.
model LessonLog {
  id               String          @id @default(cuid())
  schoolId         String
  classId          String
  subjectId        String
  teacherId        String
  date             DateTime        @db.Date
  periodNumber     Int
  semester         Int
  content          String?
  comment          String?
  rating           String?
  status           LessonLogStatus @default(DONE)
  absentStudentIds String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([classId, date, periodNumber])
  @@index([teacherId, date])
}

// ============================================================================
// Phase 3: school bus (xe tuyến)
// ============================================================================

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum BusStaffRole {
  DRIVER
  MONITOR
}

enum BusDirection {
  PICKUP
  DROPOFF
}

enum BusTripStatus {
  PLANNED
  RUNNING
  DONE
  CANCELLED
}

enum BoardingType {
  BOARD
  ALIGHT
}

model Vehicle {
  id               String        @id @default(cuid())
  schoolId         String
  plateNumber      String
  model            String?
  capacity         Int
  inspectionExpiry DateTime?     @db.Date
  insuranceExpiry  DateTime?     @db.Date
  status           VehicleStatus @default(ACTIVE)
  notes            String?

  school School     @relation(fields: [schoolId], references: [id])
  routes BusRoute[]
  trips  BusTrip[]

  @@unique([schoolId, plateNumber])
}

// Drivers and bus monitors. A linked user (role DRIVER) can use the driver page.
model BusStaff {
  id            String       @id @default(cuid())
  schoolId      String
  fullName      String
  phone         String
  role          BusStaffRole
  licenseNumber String?
  licenseExpiry DateTime?    @db.Date
  userId        String?      @unique
  isActive      Boolean      @default(true)

  school        School     @relation(fields: [schoolId], references: [id])
  user          User?      @relation(fields: [userId], references: [id])
  drivingRoutes BusRoute[] @relation("RouteDriver")
  monitorRoutes BusRoute[] @relation("RouteMonitor")
  drivenTrips   BusTrip[]

  @@index([schoolId])
}

model BusRoute {
  id        String       @id @default(cuid())
  schoolId  String
  name      String
  direction BusDirection
  vehicleId String?
  driverId  String?
  monitorId String?
  startTime String // HH:mm, school local time
  isActive  Boolean      @default(true)

  school      School          @relation(fields: [schoolId], references: [id])
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver      BusStaff?       @relation("RouteDriver", fields: [driverId], references: [id])
  monitor     BusStaff?       @relation("RouteMonitor", fields: [monitorId], references: [id])
  stops       BusStop[]
  assignments BusAssignment[]
  trips       BusTrip[]

  @@unique([schoolId, name])
}

model BusStop {
  id          String  @id @default(cuid())
  routeId     String
  order       Int
  name        String
  address     String?
  lat         Float
  lng         Float
  plannedTime String? // HH:mm

  route       BusRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments BusAssignment[]
  boardings   BoardingEvent[]

  @@unique([routeId, order])
}

model BusAssignment {
  id             String  @id @default(cuid())
  schoolId       String
  routeId        String
  stopId         String
  studentId      String
  academicYearId String
  isActive       Boolean @default(true)

  school       School       @relation(fields: [schoolId], references: [id])
  route        BusRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop         BusStop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([routeId, studentId])
  @@index([studentId])
}

// One run of a route on one day. lastLat/lastLng is denormalized for the live map.
model BusTrip {
  id             String        @id @default(cuid())
  schoolId       String
  routeId        String
  date           DateTime      @db.Date
  status         BusTripStatus @default(PLANNED)
  vehicleId      String?
  driverId       String?
  startedAt      DateTime?
  endedAt        DateTime?
  lastLat        Float?
  lastLng        Float?
  lastLocationAt DateTime?

  school    School          @relation(fields: [schoolId], references: [id])
  route     BusRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver    BusStaff?       @relation(fields: [driverId], references: [id])
  locations BusLocation[]
  boardings BoardingEvent[]

  @@unique([routeId, date])
  @@index([schoolId, date, status])
}

model BusLocation {
  id         String   @id @default(cuid())
  tripId     String
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  recordedAt DateTime

  trip BusTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
}

model BoardingEvent {
  id           String       @id @default(cuid())
  schoolId     String
  tripId       String
  studentId    String
  type         BoardingType
  stopId       String?
  lat          Float?
  lng          Float?
  occurredAt   DateTime     @default(now())
  recordedById String?
  note         String?

  school  School   @relation(fields: [schoolId], references: [id])
  trip    BusTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stop    BusStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([tripId, occurredAt])
  @@index([studentId, occurredAt])
}

// ============================================================================
// Phase 3: admissions (tuyển sinh) and start-of-year service registration
// ============================================================================

enum AdmissionRoundStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  ACCEPTED
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum ApplicationSource {
  ONLINE
  IMPORT
  MANUAL
}

enum RegistrationStatus {
  SUBMITTED
  CONFIRMED
}

model AdmissionRound {
  id             String               @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  gradeLevel     Int
  startDate      DateTime             @db.Date
  endDate        DateTime             @db.Date
  capacity       Int?
  description    String?
  status         AdmissionRoundStatus @default(OPEN)
  createdAt      DateTime             @default(now())

  school       School                 @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id])
  applications AdmissionApplication[]

  @@unique([schoolId, name])
}

model AdmissionApplication {
  id                   String               @id @default(cuid())
  schoolId             String
  roundId              String
  code                 String
  fullName             String
  gender               Gender?
  dateOfBirth          DateTime             @db.Date
  address              String?
  previousSchool       String?
  guardianName         String
  guardianPhone        String
  guardianEmail        String?
  guardianRelationship GuardianRelationship @default(GUARDIAN)
  notes                String?
  status               ApplicationStatus    @default(SUBMITTED)
  source               ApplicationSource    @default(ONLINE)
  score                Float?
  screeningNote        String?
  classId              String?
  studentId            String?              @unique
  submittedAt          DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  school  School         @relation(fields: [schoolId], references: [id])
  round   AdmissionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  class   Class?         @relation(fields: [classId], references: [id])
  student Student?       @relation(fields: [studentId], references: [id])

  @@unique([schoolId, code])
  @@unique([roundId, fullName, dateOfBirth, guardianPhone])
  @@index([roundId, status])
}

// Đăng ký dịch vụ đầu năm: canteen, bus, uniform sizes... one per student per year.
model ServiceRegistration {
  id                String             @id @default(cuid())
  schoolId          String
  studentId         String
  academicYearId    String
  canteen           Boolean            @default(false)
  bus               Boolean            @default(false)
  busStopNote       String?
  uniform           Json?
  extras            Json?
  note              String?
  status            RegistrationStatus @default(SUBMITTED)
  submittedByUserId String?
  updatedAt         DateTime           @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, status])
}

// ============================================================================
// Phase 3: HR (nhân sự)
// ============================================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  PROBATION
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  RETIRED
}

enum EmployeeDocumentKind {
  DEGREE
  CERTIFICATE
  LICENSE
  OTHER
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// Every person on the payroll. Teachers link to their Teacher record.
model Employee {
  id             String         @id @default(cuid())
  schoolId       String
  code           String
  fullName       String
  gender         Gender?
  dateOfBirth    DateTime?      @db.Date
  idNumber       String? // CCCD
  phone          String?
  email          String?
  address        String?
  department     String?
  position       String
  employmentType EmploymentType @default(FULL_TIME)
  hireDate       DateTime?      @db.Date
  status         EmployeeStatus @default(ACTIVE)
  teacherId      String?        @unique
  userId         String?        @unique
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school      School               @relation(fields: [schoolId], references: [id])
  teacher     Teacher?             @relation(fields: [teacherId], references: [id])
  user        User?                @relation(fields: [userId], references: [id])
  documents   EmployeeDocument[]
  contracts   EmploymentContract[]
  workHistory WorkHistory[]
  leaves      LeaveRequest[]
  assets      Asset[]
  assetLoans  AssetLoan[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
}

model EmployeeDocument {
  id         String               @id @default(cuid())
  employeeId String
  kind       EmployeeDocumentKind
  name       String
  issuer     String?
  issuedAt   DateTime?            @db.Date
  expiresAt  DateTime?            @db.Date
  fileUrl    String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmploymentContract {
  id         String         @id @default(cuid())
  employeeId String
  type       EmploymentType
  startDate  DateTime       @db.Date
  endDate    DateTime?      @db.Date
  salary     Int?
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model WorkHistory {
  id           String    @id @default(cuid())
  employeeId   String
  fromDate     DateTime  @db.Date
  toDate       DateTime? @db.Date
  organization String
  position     String
  notes        String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  schoolId     String
  employeeId   String
  type         LeaveType
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  days         Float
  reason       String
  status       LeaveStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())

  school   School   @relation(fields: [schoolId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([employeeId])
}

// ============================================================================
// Phase 3: assets (tài sản)
// ============================================================================

enum AssetStatus {
  IN_USE
  IN_STORAGE
  UNDER_MAINTENANCE
  LENT
  DISPOSED
}

enum AuditStatus {
  OPEN
  CLOSED
}

model AssetCategory {
  id              String @id @default(cuid())
  schoolId        String
  name            String
  usefulLifeYears Int    @default(5)

  school School  @relation(fields: [schoolId], references: [id])
  assets Asset[]

  @@unique([schoolId, name])
}

model Supplier {
  id       String  @id @default(cuid())
  schoolId String
  name     String
  phone    String?
  email    String?
  address  String?
  taxCode  String?

  school School  @relation(fields: [schoolId], references: [id])
  assets Asset[]

  @@unique([schoolId, name])
}

model Asset {
  id                  String      @id @default(cuid())
  schoolId            String
  code                String
  name                String
  categoryId          String
  supplierId          String?
  serialNumber        String?
  purchaseDate        DateTime?   @db.Date
  purchasePrice       Int?
  // Overrides the category default for straight-line depreciation.
  usefulLifeYears     Int?
  location            String?
  custodianEmployeeId String?
  status              AssetStatus @default(IN_USE)
  disposedAt          DateTime?   @db.Date
  notes               String?
  createdAt           DateTime    @default(now())

  school      School             @relation(fields: [schoolId], references: [id])
  category    AssetCategory      @relation(fields: [categoryId], references: [id])
  supplier    Supplier?          @relation(fields: [supplierId], references: [id])
  custodian   Employee?          @relation(fields: [custodianEmployeeId], references: [id])
  maintenance AssetMaintenance[]
  loans       AssetLoan[]
  auditItems  AssetAuditItem[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
}

model AssetMaintenance {
  id          String    @id @default(cuid())
  assetId     String
  date        DateTime  @db.Date
  description String
  cost        Int?
  vendor      String?
  nextDueDate DateTime? @db.Date

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
}

model AssetLoan {
  id                 String    @id @default(cuid())
  schoolId           String
  assetId            String
  borrowerEmployeeId String?
  borrowerName       String?
  department         String?
  lentAt             DateTime  @default(now())
  dueAt              DateTime?
  returnedAt         DateTime?
  note               String?

  school   School    @relation(fields: [schoolId], references: [id])
  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  borrower Employee? @relation(fields: [borrowerEmployeeId], references: [id])

  @@index([assetId, returnedAt])
}

// Kiểm kê: a stocktake session with one line per asset checked.
model AssetAudit {
  id        String      @id @default(cuid())
  schoolId  String
  name      String
  date      DateTime    @db.Date
  status    AuditStatus @default(OPEN)
  createdAt DateTime    @default(now())

  school School           @relation(fields: [schoolId], references: [id])
  items  AssetAuditItem[]

  @@index([schoolId, date])
}

model AssetAuditItem {
  id        String  @id @default(cuid())
  auditId   String
  assetId   String
  found     Boolean @default(true)
  condition String?
  note      String?

  audit AssetAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  asset Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([auditId, assetId])
}

// ---------------------------------------------------------------------------
// Phase 4: gradebook (Thông tư 22/2021), conduct scoring, student accounts, LMS
// ---------------------------------------------------------------------------

enum AssessmentType {
  SCORE // đánh giá bằng điểm số
  COMMENT // đánh giá bằng nhận xét (Đạt / Chưa đạt)
}

enum ScoreKind {
  TX // đánh giá thường xuyên (hệ số 1)
  GK // giữa kỳ (hệ số 2)
  CK // cuối kỳ (hệ số 3)
}

enum ResultLevel {
  TOT
  KHA
  DAT
  CHUA_DAT
}

enum PromotionStatus {
  PROMOTED // được lên lớp
  RETEST // kiểm tra lại trong hè
  RETAINED // ở lại lớp
}

/// How a subject is assessed at this school and how many regular marks a semester has.
model SubjectSetting {
  id             String         @id @default(cuid())
  schoolId       String
  subjectId      String
  assessment     AssessmentType @default(SCORE)
  // Number of ĐĐGtx per semester (TT22: 2 for <= 35 periods/year, 3 for <= 70, 4 above).
  regularCount   Int            @default(3)
  periodsPerYear Int?

  school  School  @relation(fields: [schoolId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, subjectId])
}

/// One mark: a regular, mid-term or end-of-term score (or Đạt/Chưa đạt for comment subjects).
model Score {
  id             String    @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  classId        String
  studentId      String
  subjectId      String
  kind           ScoreKind
  index          Int       @default(1)
  value          Decimal?  @db.Decimal(4, 1)
  passed         Boolean?
  note           String?
  teacherId      String?
  updatedAt      DateTime  @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, academicYearId, semester, kind, index])
  @@index([classId, subjectId, academicYearId, semester])
}

/// Computed subject average per semester (1, 2) or year (semester 0).
model SubjectResult {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  classId        String
  studentId      String
  subjectId      String
  average        Decimal? @db.Decimal(4, 1)
  // Phase 6: miễn học (MG). Exempt subjects have no average and do not count towards the term result.
  exempt         Boolean  @default(false)
  passed         Boolean?
  comment        String?
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, academicYearId, semester])
  @@index([classId, academicYearId, semester])
}

/// Semester / year outcome per student: academic level, conduct level, title, promotion.
model TermResult {
  id                   String           @id @default(cuid())
  schoolId             String
  academicYearId       String
  semester             Int
  classId              String
  studentId            String
  academic             ResultLevel?
  conduct              ResultLevel?
  title                String?
  promotion            PromotionStatus?
  absentDays           Int              @default(0)
  homeroomComment      String?
  // Phase 7 (year only): academic level once every retake has a result (Điều 14 TT22), conduct
  // re-evaluated after summer training (Điều 13), and a promotion the school sets by hand.
  academicAfterRetake  ResultLevel?
  conductAfterTraining ResultLevel?
  promotionOverride    PromotionStatus?
  updatedAt            DateTime         @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, semester])
  @@index([classId, academicYearId, semester])
}

/// Marks of a class are frozen for the semester once leadership locks them.
model GradeLock {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  classId        String
  lockedAt       DateTime @default(now())
  lockedById     String

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, semester])
}

enum ConductStatus {
  DRAFT
  SELF_ASSESSED
  REVIEWED
  APPROVED
}

/// A school's conduct (rèn luyện) criteria; points add up to 100.
model ConductCriterion {
  id        String  @id @default(cuid())
  schoolId  String
  code      String
  name      String
  maxPoints Int
  groupName String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  school School                  @relation(fields: [schoolId], references: [id])
  items  ConductAssessmentItem[]

  @@unique([schoolId, code])
}

/// Conduct scoring per student and semester (month 0 = whole semester).
model ConductAssessment {
  id             String        @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  month          Int           @default(0)
  classId        String
  studentId      String
  status         ConductStatus @default(DRAFT)
  selfTotal      Int?
  teacherTotal   Int?
  finalTotal     Int?
  level          ResultLevel?
  selfComment    String?
  teacherComment String?
  reviewedById   String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school       School                  @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id])
  class        Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items        ConductAssessmentItem[]

  @@unique([studentId, academicYearId, semester, month])
  @@index([classId, academicYearId, semester])
}

model ConductAssessmentItem {
  id            String  @id @default(cuid())
  assessmentId  String
  criterionId   String
  selfPoints    Int?
  teacherPoints Int?
  note          String?

  assessment ConductAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion  ConductCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, criterionId])
}

/// An uploaded file (lesson material, course cover, SCORM package) stored under UPLOAD_DIR.
model StoredFile {
  id           String   @id @default(cuid())
  schoolId     String
  uploadedById String?
  name         String
  mimeType     String
  size         Int
  path         String
  // SCORM packages: entry page inside the extracted package, e.g. "index_lms.html".
  launchPath   String?
  createdAt    DateTime @default(now())

  school     School   @relation(fields: [schoolId], references: [id])
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  lessons    Lesson[]
  courses    Course[]
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  DOCUMENT
  SCORM
  H5P
  TEXT
  LINK
  QUIZ
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// An online course owned by a teacher; classIds is the audience (empty = whole school).
model Course {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String?
  subjectId      String?
  gradeLevel     Int?
  teacherId      String
  title          String
  description    String?
  coverFileId    String?
  status         CourseStatus @default(DRAFT)
  classIds       String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school       School             @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear?      @relation(fields: [academicYearId], references: [id])
  subject      Subject?           @relation(fields: [subjectId], references: [id])
  teacher      Teacher            @relation(fields: [teacherId], references: [id])
  cover        StoredFile?        @relation(fields: [coverFileId], references: [id], onDelete: SetNull)
  sections     CourseSection[]
  lessons      Lesson[]
  enrollments  CourseEnrollment[]
  threads      DiscussionThread[]
  liveSessions LiveSession[]
  tests        Test[]

  @@index([schoolId, status])
}

model CourseSection {
  id        String @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

/// One unit of content: video, document, SCORM/H5P package, text, link or quiz.
model Lesson {
  id          String     @id @default(cuid())
  schoolId    String
  courseId    String
  sectionId   String?
  title       String
  type        LessonType
  content     String?
  fileId      String?
  url         String?
  testId      String?
  durationMin Int?
  sortOrder   Int        @default(0)
  isRequired  Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  school   School             @relation(fields: [schoolId], references: [id])
  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section  CourseSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  file     StoredFile?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  test     Test?              @relation(fields: [testId], references: [id], onDelete: SetNull)
  progress LessonProgress[]
  threads  DiscussionThread[]

  @@index([courseId])
}

model CourseEnrollment {
  id          String    @id @default(cuid())
  courseId    String
  studentId   String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  progressPct Int       @default(0)

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

model LessonProgress {
  id           String         @id @default(cuid())
  lessonId     String
  studentId    String
  status       ProgressStatus @default(IN_PROGRESS)
  secondsSpent Int            @default(0)
  // SCORM 1.2 CMI data model as the package left it.
  scormData    Json?
  lastAt       DateTime       @default(now())
  completedAt  DateTime?

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model DiscussionThread {
  id        String   @id @default(cuid())
  schoolId  String
  courseId  String
  lessonId  String?
  authorId  String
  title     String
  body      String
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School           @relation(fields: [schoolId], references: [id])
  course Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  author User             @relation(fields: [authorId], references: [id])
  posts  DiscussionPost[]

  @@index([courseId, createdAt])
}

model DiscussionPost {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id])

  @@index([threadId, createdAt])
}

/// A scheduled live class; the room is a Jitsi Meet room name (no account needed).
model LiveSession {
  id          String     @id @default(cuid())
  schoolId    String
  courseId    String
  title       String
  startsAt    DateTime
  durationMin Int        @default(45)
  roomName    String     @unique
  provider    String     @default("jitsi")
  status      LiveStatus @default(SCHEDULED)
  startedAt   DateTime?
  endedAt     DateTime?
  createdById String
  createdAt   DateTime   @default(now())

  school      School           @relation(fields: [schoolId], references: [id])
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances LiveAttendance[]

  @@index([schoolId, startsAt])
}

model LiveAttendance {
  id        String    @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  NUMERIC
  MATCHING
  ORDERING
  ESSAY
}

enum TestKind {
  PRACTICE
  QUIZ
  EXAM
  CONTEST
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

/// Question bank: 9 types, difficulty 1 (nhận biết) to 6 (sáng tạo).
model Question {
  id          String       @id @default(cuid())
  schoolId    String
  subjectId   String?
  gradeLevel  Int?
  type        QuestionType
  difficulty  Int          @default(1)
  content     String
  options     Json?
  answer      Json?
  explanation String?
  tags        String[]
  createdById String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  testQuestions TestQuestion[]

  @@index([schoolId, subjectId, gradeLevel])
}

/// A quiz inside a course, a standalone exam for classes, or a school-wide contest.
model Test {
  id               String     @id @default(cuid())
  schoolId         String
  courseId         String?
  subjectId        String?
  gradeLevel       Int?
  kind             TestKind   @default(QUIZ)
  title            String
  description      String?
  status           TestStatus @default(DRAFT)
  timeLimitMin     Int?
  maxAttempts      Int        @default(1)
  shuffleQuestions Boolean    @default(false)
  shuffleOptions   Boolean    @default(false)
  showResults      Boolean    @default(true)
  passPercent      Int?
  openAt           DateTime?
  closeAt          DateTime?
  classIds         String[]
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  school    School         @relation(fields: [schoolId], references: [id])
  course    Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id])
  questions TestQuestion[]
  attempts  TestAttempt[]
  lessons   Lesson[]

  @@index([schoolId, kind, status])
}

model TestQuestion {
  id         String  @id @default(cuid())
  testId     String
  questionId String
  sortOrder  Int     @default(0)
  points     Decimal @default(1) @db.Decimal(5, 2)

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
}

model TestAttempt {
  id            String        @id @default(cuid())
  testId        String
  studentId     String
  attemptNo     Int           @default(1)
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  // Question ids in the order shown to the student (after shuffling).
  questionOrder String[]
  // { [questionId]: answer } as submitted.
  answers       Json?
  // { [questionId]: { points, max, correct, manual? } } after grading.
  grading       Json?
  score         Decimal?      @db.Decimal(6, 2)
  maxScore      Decimal       @default(0) @db.Decimal(6, 2)
  needsGrading  Boolean       @default(false)
  gradedById    String?
  gradedAt      DateTime?
  durationSec   Int?

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId, attemptNo])
  @@index([studentId])
}

// ============================================================================
// Phase 5: district level, nightly statistics, alerts, audit log, MOET exchange
// ============================================================================

enum DistrictLevel {
  // Phòng GD&ĐT (district / ward office)
  PHONG
  // Sở GD&ĐT (province department)
  SO
}

enum AlertKind {
  // Share of studying students present (on time or late) on the day, in percent.
  ATTENDANCE_RATE_BELOW
  // Share of present students who arrived late, in percent.
  LATE_RATE_ABOVE
  // Unpaid amount of invoices past their due date, in VND.
  OVERDUE_FEES_ABOVE
  // Health incidents recorded on the day.
  HEALTH_INCIDENTS_ABOVE
  // Students absent on every school day of the last N days (threshold = N days, minimum 2).
  ABSENT_STREAK
}

enum MoetExportKind {
  STUDENTS
  TEACHERS
  CLASSES
  TERM_RESULTS
}

enum MoetExportStatus {
  DONE
  FAILED
}

/**
 * Phòng / Sở GD&ĐT: groups schools for the district dashboards.
 */
model District {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  level     DistrictLevel @default(PHONG)
  province  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  schools    School[]
  users      User[]
  alertRules AlertRule[]
}

/**
 * One row per school and local day, computed by the nightly job (and refreshed during the day).
 */
model DailyStat {
  id                String   @id @default(cuid())
  schoolId          String
  date              DateTime @db.Date
  // Students with status STUDYING on the day the row was computed.
  students          Int      @default(0)
  // Gate-based attendance: students with any event, of which how many arrived after lateAfter.
  present           Int      @default(0)
  late              Int      @default(0)
  absent            Int      @default(0)
  // present / students × 100, one decimal.
  attendanceRate    Decimal  @default(0) @db.Decimal(5, 1)
  // Homeroom roll call: ABSENT + EXCUSED rows of the day.
  homeroomAbsent    Int      @default(0)
  invoicesIssued    Int      @default(0)
  invoicesPaid      Int      @default(0)
  // VND received on the day (payments) and unpaid past due at the end of the day.
  revenue           BigInt   @default(0)
  overdueAmount     BigInt   @default(0)
  healthIncidents   Int      @default(0)
  // Students with lesson progress, and attempts handed in, on the day.
  lmsActiveStudents Int      @default(0)
  testsSubmitted    Int      @default(0)
  computedAt        DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, date])
  @@index([date])
}

/**
 * A threshold on a daily statistic; school rules belong to a school, district rules apply to every school of the district.
 */
model AlertRule {
  id         String    @id @default(cuid())
  schoolId   String?
  districtId String?
  kind       AlertKind
  threshold  Decimal   @db.Decimal(14, 2)
  name       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school   School?      @relation(fields: [schoolId], references: [id])
  district District?    @relation(fields: [districtId], references: [id])
  events   AlertEvent[]

  @@index([schoolId])
  @@index([districtId])
}

/**
 * A rule that fired for a school on a day; one event per rule, school and day.
 */
model AlertEvent {
  id               String    @id @default(cuid())
  ruleId           String
  schoolId         String
  date             DateTime  @db.Date
  kind             AlertKind
  value            Decimal   @db.Decimal(14, 2)
  threshold        Decimal   @db.Decimal(14, 2)
  message          String
  acknowledgedAt   DateTime?
  acknowledgedById String?
  createdAt        DateTime  @default(now())

  rule   AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  school School    @relation(fields: [schoolId], references: [id])

  @@unique([ruleId, schoolId, date])
  @@index([schoolId, createdAt])
}

/**
 * Every state-changing API call: who did what, where, with which result. Bodies are stored with secrets redacted.
 */
model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  districtId String?
  userId     String?
  userRole   Role?
  method     String
  path       String
  // Module name taken from the path ("finance", "students", ...).
  area       String
  statusCode Int
  ip         String?
  userAgent  String?
  body       Json?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/**
 * A file produced for the MOET education database (CSDL ngành GDĐT).
 */
model MoetExport {
  id             String           @id @default(cuid())
  schoolId       String
  kind           MoetExportKind
  academicYearId String?
  semester       Int?
  fileId         String?
  fileName       String
  rows           Int              @default(0)
  status         MoetExportStatus @default(DONE)
  error          String?
  createdById    String?
  createdAt      DateTime         @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 6: gradebook control (column locks, entry window, edit log), exemptions,
// what families see of grades.
// ---------------------------------------------------------------------------

/// Locks one mark column of a grade level for a semester ("khóa điểm" per khối × môn × cột).
model GradeColumnLock {
  id             String    @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  gradeLevel     Int
  /// Null locks the column in every subject.
  subjectId      String?
  kind           ScoreKind
  /// TX column number; 0 locks every TX column. Always 0 for GK and CK.
  index          Int       @default(0)
  lockedById     String
  lockedAt       DateTime  @default(now())

  school  School   @relation(fields: [schoolId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYearId, semester, gradeLevel])
}

/// When teachers may enter marks in a semester and how many times a mark may be changed once entered.
model GradeEntryWindow {
  id             String    @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  opensAt        DateTime?
  closesAt       DateTime?
  /// Changes a teacher may make to a mark that already had a value; null = unlimited.
  maxEdits       Int?
  updatedAt      DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([academicYearId, semester])
}

enum ScoreEditSource {
  MANUAL
  IMPORT
}

/// Every change to a mark (the "thống kê sửa điểm" log).
model ScoreEdit {
  id             String          @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  classId        String
  studentId      String
  subjectId      String
  kind           ScoreKind
  index          Int
  oldValue       Decimal?        @db.Decimal(4, 1)
  newValue       Decimal?        @db.Decimal(4, 1)
  oldPassed      Boolean?
  newPassed      Boolean?
  editedById     String
  source         ScoreEditSource @default(MANUAL)
  createdAt      DateTime        @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, academicYearId, semester])
  @@index([classId, subjectId, semester])
  @@index([studentId, subjectId, academicYearId, semester, kind, index])
}

/// Miễn học môn (e.g. physical education on medical grounds) for a semester, or the year (semester 0).
model SubjectExemption {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  studentId      String
  subjectId      String
  reason         String?
  createdById    String
  createdAt      DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, academicYearId, semester])
  @@index([schoolId, academicYearId])
}

/// What the parent and student apps show of grades (SMAS "cấu hình EduOne").
model GradeVisibility {
  schoolId        String   @id
  regularMarks    Boolean  @default(true)
  examMarks       Boolean  @default(true)
  averages        Boolean  @default(true)
  termResults     Boolean  @default(true)
  titles          Boolean  @default(true)
  absences        Boolean  @default(true)
  homeroomComment Boolean  @default(true)
  teacherNotes    Boolean  @default(true)
  /// Hide marks of the current semester until the school locks the class's gradebook.
  onlyAfterLock   Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

// ---------------------------------------------------------------------------
// Phase 7: end of the school year: retakes (kiểm tra lại), summer training (rèn
// luyện hè), promotion after both, and the THCS completion review (xét công nhận
// hoàn thành chương trình giáo dục THCS, confirmed by the principal in the học bạ).
// ---------------------------------------------------------------------------

/// A subject a student is re-assessed in after the year (Điều 14 TT22); its result replaces the year result of the subject for promotion.
model SubjectRetake {
  id             String    @id @default(cuid())
  schoolId       String
  academicYearId String
  classId        String
  studentId      String
  subjectId      String
  /// Retake mark of a score subject.
  score          Decimal?  @db.Decimal(4, 1)
  /// Đạt / Chưa đạt of a comment subject.
  passed         Boolean?
  note           String?
  createdById    String
  createdAt      DateTime  @default(now())
  enteredById    String?
  enteredAt      DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, academicYearId])
  @@index([schoolId, academicYearId])
}

/// Rèn luyện trong kì nghỉ hè (Điều 13 TT22): tasks set by the homeroom teacher and the re-evaluated year conduct.
model SummerTraining {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  classId        String
  studentId      String
  tasks          String
  /// Re-evaluated year conduct; it replaces the year conduct for promotion.
  result         ResultLevel?
  comment        String?
  assignedById   String
  assignedAt     DateTime     @default(now())
  evaluatedById  String?
  evaluatedAt    DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
}

/// One round of the THCS completion review: the council (hội đồng xét), its meeting and the recognition decision.
model CompletionRound {
  id                String    @id @default(cuid())
  schoolId          String
  academicYearId    String
  /// 1 = before the school year ends; 2 = before the next one starts (after retakes and summer training).
  round             Int
  /// The principal's decision setting up the council.
  councilDecisionNo String?
  councilDecidedOn  DateTime? @db.Date
  meetingAt         DateTime?
  meetingPlace      String?
  /// [{ name, position, role }]; role is Chủ tịch, Phó Chủ tịch, Thư ký or Ủy viên.
  members           Json      @default("[]")
  /// The recognition decision, set when the round is recognised.
  decisionNo        String?
  decidedOn         DateTime? @db.Date
  signerTitle       String?
  signerName        String?
  recognizedAt      DateTime?
  recognizedById    String?
  /// Who the decision left out and why, as they stood at the decision, so the lists and minutes print the same later.
  notRecognized     Json?
  updatedAt         DateTime  @updatedAt

  school  School             @relation(fields: [schoolId], references: [id])
  records CompletionRecord[]

  @@unique([academicYearId, round])
  @@index([schoolId])
}

/// A grade 9 student in the completion review: the dossier, priority group and, once recognised, the round and register number.
model CompletionRecord {
  id              String    @id @default(cuid())
  schoolId        String
  academicYearId  String
  studentId       String
  classId         String
  dossierComplete Boolean   @default(true)
  /// Diện ưu tiên, printed on the list.
  priority        String?
  note            String?
  roundId         String?
  /// Number in the school's register of completion confirmations (số vào sổ).
  registerNo      Int?
  recognizedAt    DateTime?
  updatedAt       DateTime  @updatedAt

  school  School           @relation(fields: [schoolId], references: [id])
  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  round   CompletionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
}

// ---- Phase 8: SMS to parents and teachers, direct sync with the education database, signed records ----

enum SmsAudience {
  PARENT
  TEACHER
}

enum SmsCampaignStatus {
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

/// SMS settings of a school: the brandname texts go out under and the monthly quotas.
model SmsSetting {
  schoolId           String   @id
  /// Sender name registered with the carrier, e.g. THCS DEMO.
  brandname          String?
  /// SMS (each 160 characters, or 70 with diacritics) a class may send its parents per month.
  classMonthlyQuota  Int      @default(200)
  /// SMS per month for messages charged to no class: to teachers and staff.
  schoolMonthlyQuota Int      @default(500)
  updatedAt          DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

/// A class's own monthly SMS quota when it differs from the school's default.
model SmsClassQuota {
  classId      String   @id
  schoolId     String
  monthlyLimit Int
  updatedAt    DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// A reusable text; {hoc_sinh}, {lop} and the other placeholders are filled per recipient.
model SmsTemplate {
  id        String      @id @default(cuid())
  schoolId  String
  name      String
  audience  SmsAudience
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

/// One text to a group of parents or teachers, sent now or at a set time.
model SmsCampaign {
  id          String            @id @default(cuid())
  schoolId    String
  audience    SmsAudience
  title       String
  /// As written, placeholders included.
  body        String
  /// With Vietnamese diacritics (70 characters per SMS) or without (160).
  accented    Boolean           @default(false)
  /// What was picked, for the history: { classIds, studentIds, teacherIds, allTeachers, label }.
  scope       Json
  scheduledAt DateTime
  status      SmsCampaignStatus @default(SCHEDULED)
  recipients  Int               @default(0)
  /// SMS counted against the quotas.
  segments    Int               @default(0)
  createdById String
  createdAt   DateTime          @default(now())
  finishedAt  DateTime?
  cancelledAt DateTime?

  school   School       @relation(fields: [schoolId], references: [id])
  messages SmsMessage[]

  @@index([schoolId, scheduledAt])
  @@index([status, scheduledAt])
}

/// One text to one phone number and how its delivery went.
model SmsMessage {
  id            String     @id @default(cuid())
  campaignId    String
  schoolId      String
  /// Place in the campaign's list: by class, then name.
  seq           Int        @default(0)
  phone         String
  /// The parent's or teacher's name.
  name          String
  studentId     String?
  /// The class whose quota pays for it; null charges the school's.
  classId       String?
  teacherId     String?
  /// Personalised, and without diacritics unless the campaign is accented.
  body          String
  segments      Int
  status        SyncStatus @default(PENDING)
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @default(now())
  externalRef   String?
  lastError     String?
  sentAt        DateTime?

  campaign SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status, nextAttemptAt])
  @@index([schoolId, classId])
}

enum MoetTarget {
  /// CSDL ngành giáo dục of the ministry.
  MOET
  /// The database of the provincial Department (Sở GD&ĐT).
  PROVINCE
}

enum MoetSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// One push of one kind of records straight to the education database, with what it refused.
model MoetSync {
  id             String         @id @default(cuid())
  schoolId       String
  target         MoetTarget
  kind           MoetExportKind
  academicYearId String?
  semester       Int?
  /// The account it signed in with; the password is never stored.
  username       String
  provider       String
  status         MoetSyncStatus
  total          Int            @default(0)
  accepted       Int            @default(0)
  rejected       Int            @default(0)
  /// [{ row, code, name, message }] for each record the database refused.
  errors         Json           @default("[]")
  /// The batch number the database gave back.
  externalRef    String?
  error          String?
  createdById    String
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, startedAt])
}

enum SignatureProvider {
  VNPT_SMARTCA
  VIETTEL_MYSIGN
}

/// A user's remote signing account and the certificate it signs with.
model SignatureProfile {
  userId        String            @id
  schoolId      String
  provider      SignatureProvider
  /// What the provider knows the signer by: CCCD number or phone.
  account       String
  certSerial    String
  certSubject   String
  certIssuer    String
  certValidFrom DateTime
  certValidTo   DateTime
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

enum ERecordKind {
  HOC_BA
}

enum ERecordStatus {
  /// Waiting for the homeroom teacher to sign.
  DRAFT
  /// Signed by the homeroom teacher, waiting for the principal.
  HOMEROOM_SIGNED
  /// Signed by the principal: issued.
  ISSUED
  /// Withdrawn; a later version replaces it.
  REVOKED
}

/// A record signed digitally: one student's học bạ for one school year.
model ERecord {
  id             String        @id @default(cuid())
  schoolId       String
  kind           ERecordKind
  studentId      String
  academicYearId String
  classId        String
  version        Int           @default(1)
  status         ERecordStatus @default(DRAFT)
  /// The document as generated ({ document, letterhead }); this is what is signed.
  content        Json
  /// SHA-256 of the canonical JSON of content.
  contentHash    String
  /// [{ role, userId, name, provider, certSerial, certSubject, signedAt, transactionId, signature }]
  signatures     Json          @default("[]")
  createdById    String
  createdAt      DateTime      @default(now())
  issuedAt       DateTime?
  revokedAt      DateTime?
  revokedReason  String?

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, kind, version])
  @@index([schoolId, academicYearId, classId])
}

// ---- Phase 9: the student record: profile, movements, commendation and discipline, leave requests ----

/// Đối tượng chính sách the school reports on.
enum PolicyGroup {
  /// Con liệt sĩ.
  MARTYR_CHILD
  /// Con thương binh, bệnh binh or of those treated as such.
  WAR_INVALID_CHILD
  /// Hộ nghèo.
  POOR_HOUSEHOLD
  /// Hộ cận nghèo.
  NEAR_POOR_HOUSEHOLD
  /// Living in an area of extreme hardship (vùng đặc biệt khó khăn).
  HARDSHIP_AREA
  /// Khuyết tật.
  DISABILITY
  /// Mồ côi.
  ORPHAN
}

enum MovementKind {
  /// Tuyển mới: admitted at the start of the level.
  ENROLLED
  /// Chuyển đến from another school.
  TRANSFER_IN
  /// Chuyển lớp within the school year.
  CLASS_CHANGE
  /// Chuyển đi to another school.
  TRANSFER_OUT
  /// Thôi học.
  DROPPED
  /// Trở lại học after leaving.
  RETURNED
}

/// A change in a student's enrolment (biến động): what the sổ đăng bộ and the transfer lists print.
model StudentMovement {
  id             String       @id @default(cuid())
  schoolId       String
  studentId      String
  kind           MovementKind
  date           DateTime     @db.Date
  academicYearId String?
  fromClassId    String?
  toClassId      String?
  /// The other school of a transfer in or out.
  otherSchool    String?
  reason         String?
  /// Number of the decision or letter behind it.
  documentNo     String?
  createdById    String
  createdAt      DateTime     @default(now())

  school    School  @relation(fields: [schoolId], references: [id])
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClass Class?  @relation("MovementFrom", fields: [fromClassId], references: [id], onDelete: SetNull)
  toClass   Class?  @relation("MovementTo", fields: [toClassId], references: [id], onDelete: SetNull)

  @@index([schoolId, date])
  @@index([studentId, date])
}

/// Hình thức khen thưởng học sinh (Thông tư 19/2025/TT-BGDĐT, Điều 5).
enum AwardForm {
  /// Tuyên dương trước lớp: any teacher.
  CLASS_PRAISE
  /// Tuyên dương trước toàn trường: the principal, on the homeroom teacher's proposal.
  SCHOOL_PRAISE
  /// Giấy khen của hiệu trưởng.
  PRINCIPAL_CERTIFICATE
  /// Thư khen of a teacher, the principal or an authority.
  LETTER
  /// Any other form, such as a bằng khen of the province.
  OTHER
}

/// A commendation of a student during the year (the year-end titles of Thông tư 22 live on TermResult).
model StudentAward {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  classId        String?
  form           AwardForm
  date           DateTime  @db.Date
  /// The achievement.
  content        String
  /// Who gives it when not the school: "UBND phường Cầu Giấy", "Sở GD&ĐT Hà Nội".
  issuer         String?
  decisionNo     String?
  createdById    String
  createdAt      DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId, academicYearId, date])
  @@index([studentId])
}

/// Biện pháp kỷ luật học sinh (Thông tư 19/2025/TT-BGDĐT, Điều 11).
enum DisciplineMeasure {
  /// Nhắc nhở.
  REMINDER
  /// Phê bình (lower and upper secondary).
  CRITICISM
  /// Yêu cầu viết bản tự kiểm điểm (lower and upper secondary).
  SELF_REVIEW
  /// Yêu cầu xin lỗi (primary).
  APOLOGY
}

/// A violation and the measure taken; the circular keeps the self-review in the school's records.
model StudentDiscipline {
  id                String            @id @default(cuid())
  schoolId          String
  studentId         String
  academicYearId    String
  classId           String?
  measure           DisciplineMeasure
  /// Mức độ vi phạm (Điều 12): 1 affects the student, 2 the group or class, 3 the school.
  severity          Int
  date              DateTime          @db.Date
  violation         String
  /// Hoạt động hỗ trợ (Điều 16): counselling, follow-up, work with the family.
  support           String?
  /// When the family confirmed the self-review and its commitment (Điều 15).
  familyConfirmedAt DateTime?         @db.Date
  createdById       String
  createdAt         DateTime          @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId, academicYearId, date])
  @@index([studentId])
}

enum AbsenceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Đơn xin nghỉ học: a parent asks the homeroom teacher to excuse their child for some days.
model AbsenceRequest {
  id            String               @id @default(cuid())
  schoolId      String
  studentId     String
  classId       String
  fromDate      DateTime             @db.Date
  toDate        DateTime             @db.Date
  /// Null for whole days, otherwise only that session of each day.
  session       Session?
  reason        String
  status        AbsenceRequestStatus @default(PENDING)
  /// The parent who sent it, or the teacher who wrote down a request made by phone.
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([classId, fromDate])
  @@index([studentId, fromDate])
}

// ---- Phase 10: phân công chuyên môn, kiêm nhiệm and định mức tiết dạy (Thông tư 05/2025/TT-BGDĐT), lịch báo giảng, sổ chủ nhiệm ----

/// How a position or duty changes a teacher's weekly teaching norm (Thông tư 05/2025/TT-BGDĐT).
enum DutyKind {
  /// A position with a norm of its own (Điều 7, 8): hiệu trưởng, phó hiệu trưởng, Tổng phụ trách Đội.
  POSITION
  /// A concurrent duty that lowers the norm (Điều 9, 10, 11). A teacher holds at most two, a homeroom class included (Điều 3).
  CONCURRENT
  /// Another reduction that is not a duty (Điều 12): tập sự, nuôi con dưới 12 tháng.
  OTHER
}

/// Danh mục chức vụ, kiêm nhiệm of a school: the periods a week each one sets or takes off.
model DutyType {
  id        String   @id @default(cuid())
  schoolId  String
  code      String
  name      String
  kind      DutyKind
  /// The weekly norm a POSITION sets, or the periods a week a CONCURRENT or OTHER duty takes off.
  periods   Decimal  @db.Decimal(4, 1)
  /// Where the number comes from: "Điều 9 Thông tư 05/2025/TT-BGDĐT".
  basis     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School        @relation(fields: [schoolId], references: [id])
  duties TeacherDuty[]

  @@unique([schoolId, code])
}

/// Phân công kiêm nhiệm: a position or duty a teacher holds in a school year, or in one semester of it.
model TeacherDuty {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  teacherId      String
  dutyTypeId     String
  /// 1 or 2; null for the whole year.
  semester       Int?
  /// Replaces the catalogue's periods for this teacher (in charge of two subject rooms: 3 periods for each).
  periods        Decimal? @db.Decimal(4, 1)
  /// "Tổ Toán - Khoa học tự nhiên", "Phòng thực hành Khoa học tự nhiên".
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dutyType     DutyType     @relation(fields: [dutyTypeId], references: [id])

  @@index([schoolId, academicYearId])
  @@index([teacherId, academicYearId])
}

/// Phân công giảng dạy: who teaches a subject in a class in a semester, and how many periods a week.
/// Two teachers may share a subject (the parts of Khoa học tự nhiên), each with their own periods.
model TeachingAssignment {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  semester       Int
  classId        String
  subjectId      String
  teacherId      String
  periodsPerWeek Decimal  @db.Decimal(4, 1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId, semester, teacherId])
  @@index([academicYearId, semester, teacherId])
}

/// Định mức tiết dạy of a school when it differs from the circular's defaults for its level.
model WorkloadSetting {
  schoolId          String   @id
  /// Periods a week a teacher teaches (Điều 7): 23 tiểu học, 19 THCS, 17 THPT.
  teacherNorm       Decimal  @db.Decimal(4, 1)
  /// Periods a week a homeroom teacher is relieved of (Điều 9): 4.
  homeroomReduction Decimal  @db.Decimal(4, 1)
  updatedAt         DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

/// Lịch báo giảng: the lesson a teacher plans for one period of a week.
model LessonPlan {
  id           String   @id @default(cuid())
  schoolId     String
  teacherId    String
  classId      String
  subjectId    String
  date         DateTime @db.Date
  periodNumber Int
  /// Tiết theo kế hoạch dạy học (phân phối chương trình) of the subject.
  lessonNo     Int?
  /// Tên bài dạy.
  title        String
  /// Đồ dùng dạy học.
  aids         String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date, periodNumber])
  @@index([classId, date])
}

/// Sổ chủ nhiệm of a class: officers, the parents' committee, groups, the seating chart and the year's plan.
/// Lists refer to students and guardians by id; those who left the class drop out when the book is read.
model HomeroomBook {
  id              String   @id @default(cuid())
  schoolId        String
  classId         String   @unique
  /// Ban cán sự lớp: [{ role, studentId }].
  officers        Json     @default("[]")
  /// Ban đại diện cha mẹ học sinh: [{ role, guardianId }].
  parentCommittee Json     @default("[]")
  /// Tổ: [{ name, leaderId, studentIds }].
  groups          Json     @default("[]")
  /// Sơ đồ chỗ ngồi: { columns, rows, seatsPerDesk, seats } with seats[row][column * seatsPerDesk + seat], row 0 at the board.
  seating         Json?
  /// Kế hoạch chủ nhiệm năm học: { situation, goals, targets, measures }.
  yearPlan        Json?
  updatedById     String?
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
}

/// Kế hoạch chủ nhiệm tháng: the month's theme, the work planned and, at the end, how it went.
model HomeroomMonthPlan {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  /// First day of the month.
  month     DateTime @db.Date
  /// Chủ điểm of the month.
  theme     String?
  tasks     String
  /// Đánh giá kết quả at the end of the month.
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, month])
}

/// Họp cha mẹ học sinh: the minutes of one meeting of the class's parents.
model ParentMeeting {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  date        DateTime @db.Date
  title       String
  /// Parents present out of those invited.
  attended    Int?
  invited     Int?
  content     String
  /// Ý kiến của cha mẹ học sinh.
  opinions    String?
  /// Kết luận, thống nhất.
  conclusions String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, date])
}

enum StudentNoteKind {
  /// Cần quan tâm, giúp đỡ.
  ATTENTION
  /// Tiêu biểu, năng khiếu.
  OUTSTANDING
  /// Tiến bộ.
  PROGRESS
  OTHER
}

/// Theo dõi học sinh: what the homeroom teacher noticed about a student, what was done and how it went.
model StudentNote {
  id          String          @id @default(cuid())
  schoolId    String
  classId     String
  studentId   String
  date        DateTime        @db.Date
  kind        StudentNoteKind
  content     String
  /// Biện pháp giáo dục, giúp đỡ.
  action      String?
  result      String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classId, date])
  @@index([studentId])
}

/// Ý kiến của Hiệu trưởng: a school leader's remarks when checking the sổ chủ nhiệm.
model HomeroomBookReview {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  date      DateTime @db.Date
  content   String
  authorId  String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, date])
}
