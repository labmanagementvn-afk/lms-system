DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Phase 2 integrations. Only sandbox implementations exist; never put real credentials here.
PAYMENT_PROVIDERS=mock
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=mock-secret
ACCOUNTING_PROVIDER=mock
# How often pending documents are pushed to accounting (ms); 0 disables the timer.
ACCOUNTING_SYNC_INTERVAL_MS=60000

# Phase 3 notifications. Only the sandbox ("mock") channel adapters exist; real FCM / Zalo ZNS / SMS / SMTP
# adapters plug in per channel. Never put real credentials here.
NOTIFY_PROVIDERS=PUSH=mock,ZALO=mock,SMS=mock,EMAIL=mock
# How often queued deliveries are pushed out (ms); 0 disables the timer.
NOTIFY_DISPATCH_INTERVAL_MS=15000
# How often scheduled announcements are checked (ms); 0 disables the timer.
ANNOUNCE_SCHEDULER_MS=30000

# Phase 4 e-learning. Uploaded lesson files and extracted SCORM packages are stored on local disk.
UPLOAD_DIR=./uploads
# Max upload size in MB.
UPLOAD_MAX_MB=200

# Phase 5 platform. Requests per minute per client IP (0 disables) and the stricter limit on /auth/login.
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
# Express "trust proxy" value when the API sits behind a reverse proxy (e.g. 1); unset = direct connections.
TRUST_PROXY=
# Max JSON body size.
JSON_BODY_LIMIT=10mb
# How often daily statistics are refreshed and yesterday's alerts evaluated (ms); 0 disables the timer.
STATS_SCHEDULER_MS=900000
# Days an audit log row is kept; 0 keeps everything.
AUDIT_RETENTION_DAYS=180

# Phase 8. Only sandbox ("mock") implementations exist; never put real credentials here. SMS texts go
# through the SMS adapter of NOTIFY_PROVIDERS above.
# Submissions to CSDL ngành and the Sở's database; the school's password is typed for each submission and never stored.
MOET_SYNC_PROVIDER=mock
# Remote signing for học bạ số, one adapter per provider.
ESIGN_PROVIDERS=VNPT_SMARTCA=mock,VIETTEL_MYSIGN=mock
# Address of the web portal printed on signed học bạ for checking them (/verify/...); unset = the portal the request came from.
PUBLIC_WEB_URL=
